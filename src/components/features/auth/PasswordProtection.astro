---
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";

import PasswordModal from "./PasswordModal.svelte";

export interface Props {
	encryptedContent: string;
	hint?: string;
}

const { encryptedContent, hint = "" } = Astro.props;

const i18nUnlocking = i18n(I18nKey.passwordUnlocking);
const i18nIncorrect = i18n(I18nKey.passwordIncorrect);
const i18nDecryptionError = i18n(I18nKey.decryptionError);
const i18nUnlock = i18n(I18nKey.passwordUnlock);
const i18nPasswordRequired = i18n(I18nKey.passwordRequired);
const i18nPasswordDecryptRetry = i18n(I18nKey.passwordDecryptRetry);
---

<div id="password-protection">
	<PasswordModal client:load hint={hint} />
</div>

<div
	id="decrypted-content"
	class="decrypted-content w-full"
	style="display: none;"
>
</div>

<style>
	.decrypted-content {
		animation: fadeIn 0.3s ease-in-out;
	}

	@keyframes fadeIn {
		from {
			opacity: 0;
			transform: translateY(10px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	:global(#decrypted-content .table-wrapper) {
		overflow-x: auto !important;
		width: 100% !important;
	}

	:global(#decrypted-content table) {
		display: table !important;
		width: 100% !important;
	}

	:global(.encrypted-hidden) {
		display: none !important;
	}

	:global(.encrypted-hidden-wrapper.encrypted-hidden) {
		display: none !important;
	}
</style>

{}
<script
	is:inline
	define:vars={{
		encryptedContent,
		i18nUnlocking,
		i18nIncorrect,
		i18nDecryptionError,
		i18nUnlock,
		i18nPasswordRequired,
		i18nPasswordDecryptRetry,
	}}
>
	function showError(message) {
		const event = new CustomEvent("password:error", { detail: message });
		document.dispatchEvent(event);
	}

	function setLoading(loading) {
		const event = new CustomEvent("password:loading", { detail: loading });
		document.dispatchEvent(event);
	}

	function clearError() {
		const event = new CustomEvent("password:clear-error", {});
		document.dispatchEvent(event);
	}

var PBKDF2_ITERATIONS = 310000;      // 必须与 crypto-utils.ts 保持一致
var SESSION_TOKEN_ITERATIONS = 50000; // 只为生成 sessionStorage 里的令牌，不用太高
var SALT_LENGTH = 16;
var IV_LENGTH = 12;
var AUTH_TAG_LENGTH = 16;
var VERSION = 3;                      // 密文协议版本，必须与 crypto-utils.ts 一致
var VERIFY_PREFIX = "MIZUKI-VERIFY:";
var STORAGE_KEY_PREFIX = "page-pwdhash-";

function base64ToUint8Array(b64) {
	var bin = atob(b64);
	var arr = new Uint8Array(bin.length);
	for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
	return arr;
}

function toHex(buf) {
	var s = "";
	for (var i = 0; i < buf.length; i++) s += ("0" + buf[i].toString(16)).slice(-2);
	return s;
}

function storageKey() {
	return STORAGE_KEY_PREFIX + window.location.pathname;
}

// 把任意文本压成 32 字节密钥材料（SHA-256，不可逆）
async function toKeyMaterial(text) {
	var d = await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text));
	return new Uint8Array(d);
}

// ★ 生成存进 sessionStorage 的「会话令牌」，而不是存密码原文。
//   直接存 sha256(密码) 是不够的：弱密码几秒就被彩虹表撞开了。
//   这里多跑 5 万次 PBKDF2，让令牌既不可逆、又没法被低成本反推。
async function deriveSessionToken(password) {
	var enc = new TextEncoder();
	var km = await crypto.subtle.importKey(
		"raw", enc.encode(password), "PBKDF2", false, ["deriveBits"]
	);
	var bits = await crypto.subtle.deriveBits(
		{
			name: "PBKDF2",
			salt: enc.encode("aectn-session-v1"),
			iterations: SESSION_TOKEN_ITERATIONS,
			hash: "SHA-256",
		},
		km, 256
	);
	return toHex(new Uint8Array(bits));
}

// 从密文头部切出 version / salt / iv / authTag / ciphertext
async function decryptContent(encData, keyMaterial) {
	var raw = base64ToUint8Array(encData);
	var pos = 0;
	var version = raw[pos++];
	if (version !== VERSION) {
		throw new Error("Unsupported crypto version: " + version);
	}
	var salt = raw.slice(pos, pos + SALT_LENGTH); pos += SALT_LENGTH;
	var iv = raw.slice(pos, pos + IV_LENGTH); pos += IV_LENGTH;
	var authTag = raw.slice(pos, pos + AUTH_TAG_LENGTH); pos += AUTH_TAG_LENGTH;
	var ciphertext = raw.slice(pos);

	var combined = new Uint8Array(ciphertext.length + AUTH_TAG_LENGTH);
	combined.set(ciphertext, 0);
	combined.set(authTag, ciphertext.length);

	var km = await crypto.subtle.importKey(
		"raw", keyMaterial, "PBKDF2", false, ["deriveKey"]
	);
	var aesKey = await crypto.subtle.deriveKey(
		{ name: "PBKDF2", salt: salt, iterations: PBKDF2_ITERATIONS, hash: "SHA-256" },
		km, { name: "AES-GCM", length: 256 }, false, ["decrypt"]
	);
	var decrypted = await crypto.subtle.decrypt(
		{ name: "AES-GCM", iv: iv }, aesKey, combined
	);
	var decoded = new TextDecoder().decode(decrypted);
	if (!decoded.startsWith(VERIFY_PREFIX)) {
		throw new Error("Verification prefix mismatch");
	}
	return decoded.substring(VERIFY_PREFIX.length);
}

// keyMaterialText = 密钥材料（要么是用户输的密码，要么是存下来的会话令牌）
async function attemptUnlock(keyMaterialText) {
	if (!keyMaterialText) {
		showError(i18nPasswordRequired);
		return;
	}

	setLoading(true);
	clearError();

	try {
		var realContent = await decryptContent(
			encryptedContent, await toKeyMaterial(keyMaterialText)
		);
			var contentDiv = document.getElementById("decrypted-content");
			var protectionDiv = document.getElementById("password-protection");

			if (contentDiv) {
				contentDiv.innerHTML = realContent;

				var scripts = contentDiv.querySelectorAll("script");
				var scriptPromises = Array.from(scripts).map(function(script) {
					return new Promise(function(resolve) {
						var newScript = document.createElement("script");
						if (script.type) {
							newScript.type = script.type;
						}
						newScript.textContent = script.textContent;
						newScript.onload = resolve;
						newScript.onerror = resolve;
						if (script.parentNode) {
							script.parentNode.replaceChild(newScript, script);
						}
						if (!newScript.src) {
							resolve(undefined);
						}
					});
				});
				await Promise.all(scriptPromises);

				if (protectionDiv && protectionDiv.parentNode) {
					protectionDiv.remove();
				}
				contentDiv.style.display = "block";

				var shareComponent = document.getElementById("share-component");
				var licenseComponent = document.getElementById("license-component");
				if (shareComponent) {
					shareComponent.classList.remove("encrypted-hidden");
				}
				if (licenseComponent) {
					licenseComponent.classList.remove("encrypted-hidden");
				}

				// 只把派生的令牌写进 storage，密码原文绝不落地
				sessionStorage.setItem(storageKey(), keyMaterialText);

				triggerPostDecryptUpdates();
			}
		} catch (error) {
			console.error(i18nDecryptionError, error);
			showError(i18nIncorrect);
			sessionStorage.removeItem(storageKey());
		} finally {
			setLoading(false);
		}
	}

	function triggerPostDecryptUpdates() {
		setTimeout(async () => {
			if (window.hljs) {
				const contentDiv = document.getElementById("decrypted-content");
				if (contentDiv) {
					contentDiv.querySelectorAll("pre code").forEach((block) => {
						window.hljs.highlightElement(block);
					});
				}
			}

			const tocElement = document.querySelector("table-of-contents");
			if (tocElement && typeof tocElement.regenerateTOC === "function") {
				tocElement.regenerateTOC();
				tocElement.init();
			}

			if (typeof window.mobileTOCInit === "function") {
				window.mobileTOCInit();
			}

			if (typeof Fancybox !== "undefined" && Fancybox.bind) {
				Fancybox.unbind("[data-fancybox]");
				Fancybox.bind("[data-fancybox]", {});
			}

			if (window.location.hash) {
				const targetId = window.location.hash.substring(1);
				const targetElement = document.getElementById(targetId);
				if (targetElement) {
					targetElement.scrollIntoView({ behavior: "smooth" });
				}
			}

			const contentDiv = document.getElementById("decrypted-content");
			if (contentDiv) {
				const images = contentDiv.querySelectorAll("img");
				images.forEach((img) => {
					if (!img.complete) {
						img.addEventListener("load", () => {
							window.dispatchEvent(new Event("scroll"));
							window.dispatchEvent(new Event("resize"));
						});
					}
				});

				[0, 100, 300, 500, 1000, 2000].forEach((delay) => {
					setTimeout(() => {
						window.dispatchEvent(new Event("scroll"));
						window.dispatchEvent(new Event("resize"));
					}, delay);
				});
			}

			if (typeof window.renderMermaidDiagrams === "function") {
				await new Promise((resolve) => setTimeout(resolve, 100));
				window.renderMermaidDiagrams();
			}
		}, 50);
	}

	document.addEventListener("password:unlock", async (e) => {
		const detail = e.detail;
		if (detail && detail.password) {
			// 密码只在这一个字符串变量里存在，验证完就只留令牌
			await attemptUnlock(await deriveSessionToken(detail.password));
		}
	});

	document.addEventListener("click", function (e) {
		const target = e.target;
		if (!target) {
			return;
		}

		const btn = target.closest(".copy-btn");

		if (btn) {
			const codeEle = btn.parentElement?.querySelector("code");

			if (codeEle) {
				let code = "";

				const lineElements = codeEle.querySelectorAll("span.line");
				if (lineElements.length > 0) {
					const lines = [];
					for (let i = 0; i < lineElements.length; i++) {
						lines.push(lineElements[i].textContent || "");
					}
					code = lines.join("\n");
				} else {
					const codeElements = codeEle.querySelectorAll(
						".code:not(summary *)",
					);
					if (codeElements.length > 0) {
						const lines = [];
						for (let i = 0; i < codeElements.length; i++) {
							lines.push(codeElements[i].textContent || "");
						}
						code = lines.join("\n");
					} else {
						code = codeEle.textContent || "";
					}
				}

				code = code.replace(/\n{3,}/g, (match) => {
					const emptyLineCount = match.length - 1;
					const resultEmptyLines = Math.ceil(emptyLineCount / 2);
					return "\n".repeat(resultEmptyLines + 1);
				});

				const copyToClipboard = async (text) => {
					try {
						await navigator.clipboard.writeText(text);
					} catch (clipboardErr) {
						console.error("Clipboard copy failed:", clipboardErr);
					}
				};

				copyToClipboard(code)
					.then(() => {
						const timeoutId = btn.getAttribute("data-timeout-id");
						if (timeoutId) {
							clearTimeout(parseInt(timeoutId));
						}

						btn.classList.add("success");

						const newTimeoutId = setTimeout(() => {
							btn.classList.remove("success");
						}, 1000);

						btn.setAttribute(
							"data-timeout-id",
							newTimeoutId.toString(),
						);
					})
					.catch((err) => {
						console.error("copy failed:", err);
					});
			}
		}
	});

	// 已解锁过的会话：直接拿令牌解密，全程不出现密码原文
	const savedToken = sessionStorage.getItem(storageKey());
	if (savedToken) {
		attemptUnlock(savedToken);
	}
</script>
